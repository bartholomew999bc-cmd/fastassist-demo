# FAST-Assist Studio — Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local or any file containing real secrets.

# ── Firebase Authentication ────────────────────────────────────────────────────
# Obtain these values from the Firebase console → Project Settings → Your apps.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional — only needed if you enable Firebase Analytics
VITE_FIREBASE_MEASUREMENT_ID=

# ── AI Inference ──────────────────────────────────────────────────────────────

# OpenRouter API key — required for live AI inference.
# Get your key at https://openrouter.ai/keys
# When absent, the application automatically switches to Mock Mode.
VITE_OPENROUTER_API_KEY=

# ── Inference Provider ────────────────────────────────────────────────────────

# Default inference provider on startup.
# Options: 'hosted' (use Qwen2.5-VL via OpenRouter) | 'mock' (offline demonstration)
# Default: hosted
VITE_PROVIDER=hosted

# ── Inference Endpoint ────────────────────────────────────────────────────────

# URL for the hosted inference endpoint (used by RESTBackend only, not QwenVL).
# Default: /infer
VITE_INFERENCE_ENDPOINT=/infer

# ── Timing ────────────────────────────────────────────────────────────────────

# How often to capture and send a frame to the AI, in milliseconds.
# Lower = more responsive but higher API usage.
# Default: 1200
VITE_INFERENCE_INTERVAL=1200

# ── Video Source ──────────────────────────────────────────────────────────────

# Path to the demo ultrasound video served from /public.
# If the file is missing, the app automatically uses the synthetic canvas source.
# Default: /videos/ultrasound.mp4
VITE_VIDEO_PATH=/videos/ultrasound.mp4

# ── UI ────────────────────────────────────────────────────────────────────────

# Default visual theme: 'dark' | 'light'
# Default: dark
VITE_THEME=dark

# ── Development ───────────────────────────────────────────────────────────────

# Enable verbose debug logging to the browser console.
# Default: false
VITE_DEBUG=false

# Development-only authentication bypass.
# When set to "true" AND running the Vite dev server (import.meta.env.DEV === true),
# the app skips Firebase and presents a mock authenticated user automatically.
# Production builds IGNORE this variable entirely — import.meta.env.DEV is
# replaced with `false` at build time, dead-code-eliminating the bypass branch.
# Never set this in a production environment file.
VITE_DEV_AUTH_BYPASS=false
