# FAST-Assist Studio — Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local or any file containing real secrets.

# ── AI Inference ──────────────────────────────────────────────────────────────

# OpenRouter API key — required for live AI inference.
# Get your key at https://openrouter.ai/keys
# When absent, the application automatically switches to Mock Mode.
VITE_OPENROUTER_API_KEY=

# ── Inference Provider ────────────────────────────────────────────────────────

# Default inference provider on startup.
# Options: 'hosted' (use Qwen2.5-VL via OpenRouter) | 'mock' (offline demonstration)
# Default: hosted
VITE_PROVIDER=hosted

# ── Inference Endpoint ────────────────────────────────────────────────────────

# URL for the hosted inference endpoint (used by RESTBackend only, not QwenVL).
# Default: /infer
VITE_INFERENCE_ENDPOINT=/infer

# ── Timing ────────────────────────────────────────────────────────────────────

# How often to capture and send a frame to the AI, in milliseconds.
# Lower = more responsive but higher API usage.
# Default: 1200
VITE_INFERENCE_INTERVAL=1200

# ── Video Source ──────────────────────────────────────────────────────────────

# Path to the demo ultrasound video served from /public.
# If the file is missing, the app automatically uses the synthetic canvas source.
# Default: /videos/ultrasound.mp4
VITE_VIDEO_PATH=/videos/ultrasound.mp4

# ── UI ────────────────────────────────────────────────────────────────────────

# Default visual theme: 'dark' | 'light'
# Default: dark
VITE_THEME=dark

# ── Development ───────────────────────────────────────────────────────────────

# Enable verbose debug logging to the browser console.
# Default: false
VITE_DEBUG=false
